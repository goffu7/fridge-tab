# Copy to .env for local development. Nothing here is required to run locally.

# Free key from https://aistudio.google.com/apikey (enables receipt scanning)
GEMINI_API_KEY=
# Optional: pin a specific Gemini model. Default is Flash-Lite: full Flash thinks too long and times out on photos.
# GEMINI_MODEL=gemini-flash-lite-latest

# Local default is a SQLite file. In production, point at Turso (libSQL):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=
